# Neon Postgres (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Google Gemini (required for AI planner)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
# BETTER_AUTH_SECRET=  # optional — auto-generated to .auth-secret if unset
# BETTER_AUTH_URL=http://localhost:3001  # optional — defaults to http://localhost:$PORT
